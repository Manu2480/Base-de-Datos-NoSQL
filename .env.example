# Use MongoDB Atlas (mongodb+srv://...) or a local MongoDB URI.
MONGODB_URI=mongodb+srv://<usuario>:<password>@<cluster>/<database>?retryWrites=true&w=majority
MONGODB_DATABASE=vector_db

# Required only for document ingestion, semantic search, and image similarity.
JINA_API_KEY=

# Required only for POST /api/rag.
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
